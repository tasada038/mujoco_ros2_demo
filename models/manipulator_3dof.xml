<mujoco model="manipulator_3dof">
  <!--
    3-DOF sample manipulator (no STL, primitives only)
      joint1 : yaw   (rotation about z)  base turntable
      joint2 : pitch (rotation about y)  shoulder
      joint3 : pitch (rotation about y)  elbow
    Mass and inertia are computed automatically from the geoms (density),
    because no <inertial> is written. Each link body has its frame at its joint.
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <default>
    <joint type="hinge" damping="0.5" armature="0.01"/>
    <geom density="1000" contype="1" conaffinity="1"/>
    <!-- Position servo: ctrl = target joint angle in RADIANS
        (compiler angle="degree" only converts angles written in the XML, not ctrl).
        inheritrange="1": ctrlrange = joint range -->
    <position kp="40" kv="2" inheritrange="1"/>
  </default>

  <statistic center="0 0 0.35" extent="0.8"/>
  <visual>
    <headlight ambient=".4 .4 .4"/>
    <!-- shadowsize="0" turns shadows off for every light -->
    <quality shadowsize="0"/>
    <!-- offwidth/offheight: offscreen buffer, must be >= the camera image size you render -->
    <global azimuth="135" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
  <texture name="grid" type="2d" builtin="checker"
          width="512" height="512" rgb1=".25 .35 .50" rgb2=".18 .25 .38" mark="edge" markrgb=".65 .75 .90"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"/>
    <material name="link" rgba=".2 .5 .8 1"/>
    <material name="joint" rgba=".9 .5 .1 1"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 3" dir="0.3 0.2 -1" castshadow="false"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>

    <!-- Fixed base (no joint = welded to the world) -->
    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.08 0.03" pos="0 0 0.03" rgba=".3 .3 .3 1"/>

      <!-- Link 1: turntable, rotates about z (yaw) -->
      <body name="link1" pos="0 0 0.06">
        <joint name="joint1" axis="0 0 1" range="-170 170"/>
        <geom name="link1_geom" type="cylinder" size="0.05 0.06" pos="0 0 0.06" material="link"/>

        <!-- Link 2: upper arm, rotates about y (pitch) -->
        <body name="link2" pos="0 0 0.12">
          <joint name="joint2" axis="0 1 0" range="-90 90"/>
          <geom name="joint2_geom" type="cylinder" size="0.045 0.05" euler="90 0 0" material="joint"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.30" size="0.03" material="link"/>

          <!-- Link 3: forearm, rotates about y (pitch) -->
          <body name="link3" pos="0 0 0.30">
            <joint name="joint3" axis="0 1 0" range="-135 135"/>
            <geom name="joint3_geom" type="cylinder" size="0.04 0.045" euler="90 0 0" material="joint"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 0.25" size="0.025" material="link"/>

            <!-- End effector -->
            <site name="ee" pos="0 0 0.27" size="0.015" rgba="1 0.2 0.2 1"/>

            <!-- RGB-D camera at the end effector.
                A MuJoCo camera looks along its local -z axis with +y up.
                xyaxes="0 -1 0  -1 0 0" -> camera -z = link +z (looks out of the tool tip),
                image up = link -x (the side that faces up when the arm reaches forward).
                RGB and depth are both rendered from this camera in Python. -->
            <camera name="ee_cam" pos="0 0 0.28" xyaxes="0 -1 0 -1 0 0" fovy="60"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Self-collision between neighbouring links is skipped automatically (parent/child) -->
  <contact>
    <exclude body1="base" body2="link2"/>
  </contact>

  <actuator>
    <position name="joint1_act" joint="joint1"/>
    <position name="joint2_act" joint="joint2" kp="80" kv="4"/>
    <position name="joint3_act" joint="joint3"/>
  </actuator>

  <sensor>
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointvel name="joint1_vel" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
    <jointvel name="joint2_vel" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/>
    <jointvel name="joint3_vel" joint="joint3"/>
    <framepos  name="ee_pos"  objtype="site" objname="ee"/>
    <framequat name="ee_quat" objtype="site" objname="ee"/>
    <framelinvel name="ee_linvel" objtype="site" objname="ee"/>
  </sensor>
</mujoco>